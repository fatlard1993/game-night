{
	"name": "game-night",
	"version": "0.1.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "A searchable library of games - board, card, online, and homemade",
	"author": "justfatlard",
	"license": "MIT",
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"prepare": "bun run prepare:githooks && bun run build",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- push checks will not run')",
		"build": "bun run build:clean && vbc-build",
		"build:clean": "rm -rf ./client/build/",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"version": "npm version",
		"deploy": "bun run build && bun run service:reload",
		"service:enable": "vbc-service enable --port 8034 --description \"Game Night\"",
		"service:disable": "vbc-service disable",
		"service:start": "vbc-service start",
		"service:stop": "vbc-service stop",
		"service:reload": "vbc-service reload"
	},
	"dependencies": {
		"@leeoniya/ufuzzy": "^1.0.19",
		"@vanilla-bean/components": "^6.3.0",
		"@vanilla-bean/hypertether": "^1.2.0",
		"argi-cli": "^1.0.0",
		"lowdb": "^7.0.1",
		"marked": "^18.0.6",
		"nanoid": "^5.1.16"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@happy-dom/global-registrator": "^20.14.6",
		"@testing-library/jest-dom": "^6.9.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"happy-dom": "^20.14.6",
		"playwright-core": "^1.61.1",
		"prettier": "3.6.2"
	}
}
